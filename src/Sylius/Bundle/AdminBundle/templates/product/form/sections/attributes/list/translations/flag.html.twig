{% set locale_code = hookable_metadata.context.locale_code|default(null) %}

{% if locale_code is not null %}
    {% set country_code = locale_code|sylius_locale_country|lower %}

    <div>
        {% if country_code %}
            <span class="flag flag-sm flag-country-{{ country_code }} me-2"></span>
        {% else %}
            <span class="badge">{{ locale_code }}</span>
        {% endif %}
    </div>
{% endif %}
