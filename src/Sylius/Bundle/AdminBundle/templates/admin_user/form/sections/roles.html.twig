{% embed '@SyliusAdmin/shared/plus_placeholder.html.twig' with { utm_campaign: 'rbac-placeholder' } %}
    {% block content %}
        <div class="card-header">
            <div class="card-title">
                {{ 'sylius.ui.roles'|trans }}
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3 field">
                <label for="plus_placeholder_roles" class="form-label">{{ 'sylius.ui.roles'|trans }}</label>
                <select multiple="multiple" class="form-select" id="plus_placeholder_roles" disabled>
                    <option>{{ 'sylius.ui.role_super_admin'|trans }}</option>
                    <option>{{ 'sylius.ui.role_product_manager'|trans }}</option>
                    <option>{{ 'sylius.ui.role_fulfillment_worker'|trans }}</option>
                    <option>{{ 'sylius.ui.role_channel_admin'|trans }}</option>
                </select>
            </div>
            <div class="mb-3 field">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="plus_placeholder_enable_permission_checker" checked disabled>
                    <label class="form-check-label" for="plus_placeholder_enable_permission_checker">
                        {{ 'sylius.ui.enabled_permission_checker'|trans }}
                    </label>
                </div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
