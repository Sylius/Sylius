{%- macro label(state) -%}
    {% set label = 'sylius.ui.' ~ state %}

    {% set state_badge = {
        (constant('Sylius\\Component\\Shipping\\Model\\ShipmentInterface::STATE_CART')): '',
        (constant('Sylius\\Component\\Shipping\\Model\\ShipmentInterface::STATE_READY')): 'bg-blue-lt',
        (constant('Sylius\\Component\\Shipping\\Model\\ShipmentInterface::STATE_SHIPPED')): 'bg-green-lt',
        (constant('Sylius\\Component\\Shipping\\Model\\ShipmentInterface::STATE_CANCELLED')): 'bg-red-lt',
    } %}

    <span class="badge {{ state_badge[state]|default('') }}" {{ sylius_test_html_attribute('shipment-state') }}>
        {{ label|trans|title }}
    </span>
{%- endmacro -%}
