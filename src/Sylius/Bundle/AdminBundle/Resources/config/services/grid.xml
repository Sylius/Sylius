<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="sylius_admin.grid_filter.ux_autocomplete" class="Sylius\Component\Grid\Filter\EntityFilter">
            <tag name="sylius.grid_filter" type="ux_autocomplete" form-type="Sylius\Bundle\AdminBundle\Form\Type\Grid\Filter\UxAutocompleteFilterType" />
        </service>

        <service id="sylius_admin.grid_filter.ux_translatable_autocomplete" class="Sylius\Component\Grid\Filter\EntityFilter">
            <tag name="sylius.grid_filter" type="ux_translatable_autocomplete" form-type="Sylius\Bundle\AdminBundle\Form\Type\Grid\Filter\UxTranslatableAutocompleteFilterType" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CatalogPromotionGrid">
            <argument>%sylius.model.catalog_promotion.class%</argument>
            <argument>%sylius.model.channel.class%</argument>
            <tag name="sylius.grid" />
         </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\AdminUserGrid">
            <argument>%sylius.model.admin_user.class%</argument>
            <tag name="sylius.grid" />
         </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ChannelGrid">
            <argument>%sylius.model.channel.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CurrencyGrid">
            <argument>%sylius.model.currency.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CustomerGrid">
            <argument>%sylius.model.customer.class%</argument>
            <argument>%sylius.model.customer_group.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CustomerGroupGrid">
            <argument>%sylius.model.customer_group.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\LocaleGrid">
            <argument>%sylius.model.locale.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\InventoryGrid">
            <argument>%sylius.model.product_variant.class%</argument>
            <argument>%sylius.model.product.class%</argument>
            <argument>%locale%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\PaymentMethodGrid">
            <argument>%sylius.model.payment_method.class%</argument>
            <argument>%locale%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductAssociationTypeGrid">
            <argument>%sylius.model.product_association_type.class%</argument>
            <argument>%locale%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductFromTaxonGrid">
            <argument>%sylius.model.taxon.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductGrid">
            <argument>%sylius.model.product.class%</argument>
            <argument>%sylius.model.channel.class%</argument>
            <argument>%sylius.model.taxon.class%</argument>

            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductAttributeGrid">
            <argument>%sylius.model.product_attribute.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CountryGrid">
            <argument>%sylius.model.country.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ShipmentGrid">
            <argument>%sylius.model.shipment.class%</argument>
            <argument>%sylius.model.channel.class%</argument>
            <argument>%sylius.model.shipping_method.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ShippingCategoryGrid">
            <argument>%sylius.model.shipping_category.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ShippingMethodGrid">
            <argument>%sylius.model.shipping_method.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\TaxCategoryGrid">
            <argument>%sylius.model.tax_category.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\TaxRateGrid">
            <argument>%sylius.model.tax_rate.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\PromotionCouponGrid">
            <argument>%sylius.model.promotion_coupon.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\PromotionGrid">
            <argument>%sylius.model.promotion.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ZoneGrid">
            <argument>%sylius.model.zone.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\PaymentGrid">
            <argument>%sylius.model.payment.class%</argument>
            <argument>%sylius.model.channel.class%</argument>
            <tag name="sylius.grid"/>
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\CustomerOrderGrid">
            <argument>%sylius.model.order.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\OrderGrid">
            <argument>%sylius.model.order.class%</argument>
            <argument>%sylius.model.channel.class%</argument>
            <argument>%sylius.model.customer.class%</argument>
            <argument>%sylius.model.product.class%</argument>
            <argument>%sylius.model.product_variant.class%</argument>
            <argument>%sylius.model.shipping_method.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductOptionGrid">
            <argument>%sylius.model.product_option.class%</argument>
            <argument>%locale%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ProductReviewGrid">
            <argument>%sylius.model.product_review.class%</argument>
            <argument>%sylius.model.product.class%</argument>
            <tag name="sylius.grid" />
        </service>

        <service id="Sylius\Bundle\AdminBundle\Grid\ChannelPricingLogEntryGrid">
            <argument>%sylius.model.channel_pricing_log_entry.class%</argument>
            <tag name="sylius.grid" />
        </service>
    </services>
</container>
