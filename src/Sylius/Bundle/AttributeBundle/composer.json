{
    "name": "sylius/attribute-bundle",
    "type": "symfony-bundle",
    "description": "Managing object attributes for Symfony applications.",
    "keywords": [
        "shop",
        "ecommerce",
        "products",
        "product",
        "assortment"
    ],
    "homepage": "https://sylius.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Jędrzejewski",
            "homepage": "https://pjedrzejewski.com"
        },
        {
            "name": "Sylius project",
            "homepage": "https://sylius.com"
        },
        {
            "name": "Community contributions",
            "homepage": "https://github.com/Sylius/Sylius/contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "ramsey/uuid": "^4.7",
        "stof/doctrine-extensions-bundle": "^1.12",
        "sylius/attribute": "^2.0",
        "sylius/resource-bundle": "^1.12",
        "symfony/framework-bundle": "^6.4.1 || ^7.4"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.0 || ^3.0",
        "doctrine/orm": "^2.18 || ^3.5",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4.1 || ^7.4",
        "symfony/form": "^6.4.1 || ^7.4"
    },
    "conflict": {
        "phpstan/phpdoc-parser": ">= 2.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.2-dev"
        },
        "symfony": {
            "require": "^7.4"
        }
    },
    "autoload": {
        "psr-4": {
            "Sylius\\Bundle\\AttributeBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Sylius\\Bundle\\AttributeBundle\\": "tests/"
        },
        "classmap": [
            "test/app/AppKernel.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
